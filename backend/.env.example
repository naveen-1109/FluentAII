NODE_ENV=development
PORT=4000
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data
SPEECH_SERVICE_URL=http://127.0.0.1:8000
# Must match SERVICE_KEY in the speech service. Change it in production.
SPEECH_SERVICE_KEY=dev-service-key
MAX_UPLOAD_MB=25
# Development only, refused in production: approve new clinicians without an admin licence check.
# Keep this false so clinicians are approved only after their licence is checked in the admin panel.
AUTO_VERIFY_CLINICIANS=false
# Admin panel. Sign in on the normal /login page with these credentials. The account is created, or its password updated, when the API starts.
# In development, if these are empty, the login is admin@fluentai.local / FluentAdmin#2026.
# In production set both; the password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=FluentAI Admin

# Optional: AI coaching for the fluency roadmap, written by Claude. Patients must switch it on
# themselves, and only practice numbers, the plan and their goals are sent (never audio or transcripts).
# Get a key at https://platform.claude.com. Without a key the roadmap still works with built-in wording.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
