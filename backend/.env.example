NODE_ENV=development
PORT=4000
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data
SPEECH_SERVICE_URL=http://127.0.0.1:8000
# Must match SERVICE_KEY in the speech service. Change it in production.
SPEECH_SERVICE_KEY=dev-service-key
MAX_UPLOAD_MB=25
# Development only: show new clinician accounts in the directory without a licence check.
AUTO_VERIFY_CLINICIANS=true
