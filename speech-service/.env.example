APP_ENV=development
SERVICE_KEY=dev-service-key
# faster-whisper settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the language, or set e.g. en
WHISPER_LANGUAGE=
WHISPER_VAD=false
WHISPER_VERBATIM_PROMPT=true
WHISPER_BEAM_SIZE=5
PAUSE_THRESHOLD_SEC=0.5
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=900
# Testing only (refused when APP_ENV=production): ASR_BACKEND=stub runs NO recognition.
# ASR_BACKEND=stub
